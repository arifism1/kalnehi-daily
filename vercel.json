{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/system-push?phase=morning&ist=0700",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/system-push?phase=evening&ist=2000",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/custom-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/scheduled-notifications",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/reset-ai-tokens",
      "schedule": "0 0 1 * *"
    }
  ]
}
