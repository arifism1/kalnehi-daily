NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Multi-vertical (Kalnehi + FIZAKI) ---
# One codebase serves both brands. In production the VERTICAL is resolved from the request
# HOST (www.kalnehi.com -> kalnehi, www.fizaki.in -> fizaki) — that is the source of truth.
# NEXT_PUBLIC_VERTICAL is only the LOCAL-DEV / per-Vercel-project build fallback used when the
# host doesn't match a known brand (localhost, *.vercel.app preview). Values: kalnehi | fizaki.
# NEXT_PUBLIC_VERTICAL=kalnehi
# Preview the FIZAKI manager/admin surfaces without real org memberships (DEMO ONLY — leave
# UNSET in production so real role gates enforce). Values: rep | manager | admin.
# NEXT_PUBLIC_FIZAKI_DEMO_ROLE=manager
# FIZAKI Vercel project: set canonical URL for metadata/sitemaps (host resolution still wins in prod).
# NEXT_PUBLIC_SITE_URL=https://www.fizaki.in
# Demo-request form on the FIZAKI landing (optional — falls back to CONTACT_SUPPORT_TO).
# FIZAKI_DEMO_TO=hello@fizaki.in

# Optional: CSP violation reporting — appended to Content-Security-Policy in next.config.ts
# CSP_REPORT_URI=https://your-report-endpoint.example/csp

# Dictate My Day / voice timeline + handwritten planner photo scan (server): https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# AI Study Partner — set to "true" for purchase card and pooled-time flows (not on-camera nav; that is off in code).
# Leave unset (or set to anything else) to hide partner UI while launch is delayed.
# NEXT_PUBLIC_ENABLE_AI_STUDY_PARTNER=true

# Study Camera — optional Gemini vision spot-checks (/api/study-camera/verify). Get a key at Google AI Studio.
# GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
# GOOGLE_GENERATIVE_AI_VISION_MODEL=gemini-2.0-flash

# Sentry (optional) — server + client error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_DSN= (same as above for server-only override)
# SENTRY_ORG=your-org
# SENTRY_PROJECT=kalnehi-daily

# PrepBrain RAG embeddings (hourly cron /api/cron/embed-user-context). Uses DeepInfra OpenAI-compatible API.
# PREPBRAIN_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Regenerate DB types after migrations: npm run types:supabase (requires linked Supabase CLI project).

# DeepInfra — Mastermind Chat (/api/prepbrain/chat) and other server routes using deepinfraClient.
# Get your key at https://deepinfra.com/dash/api_keys (required for Mastermind primary model).
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
# Model slug for routes that still read env (e.g. /api/backlog-organize), NOT Mastermind.
# Mastermind Chat uses hybrid routing: Mistral Small 24B only for "hard" classified turns — see mastermindModelTier.ts / mastermindModelsForTier().
# Fixed model slug in code: mistralai/Mistral-Small-24B-Instruct-2501 (MASTERMIND_DEEPINFRA_MODEL in groqPrepbrainModel.ts).
# MASTERMIND_FORCE_MODEL_TIER=easy   → always Groq 8b (incident fallback)
# MASTERMIND_FORCE_MODEL_TIER=hard   → always try Mistral first (debug/repro)
# Example: https://deepinfra.com/models — unset means Groq 8b only for those env-driven routes.
DEEPINFRA_CHAT_MODEL=your-deepinfra-model-id

# Groq chat-completions routing (see src/lib/groqClient.ts — getGroqModel).
# Parsing (Dictate, voice-parse-draft, handwritten JSON): cheap model by default.
# GROQ_MODEL_PARSING=llama-3.1-8b-instant
# Chat — other Groq chat routes where getGroqModel("chat") applies (not Mastermind primary).
# GROQ_MODEL_CHAT=llama-3.1-8b-instant
# Optional future use; defaults to same as parsing.
# GROQ_MODEL_REASONING=llama-3.1-8b-instant
# Legacy: if GROQ_MODEL_CHAT is unset, GROQ_DEFAULT_MODEL is used as chat id only.
# GROQ_DEFAULT_MODEL=llama-3.1-8b-instant

# Legacy optional PrepBrain Groq override (unused for Mastermind primary path today).
# GROQ_MODEL_PREPBRAIN=llama-3.3-70b-versatile

# Razorpay (server-only)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Signing secret from Razorpay Dashboard → Webhooks for https://kalnehi.com/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Razorpay Dashboard → Webhooks → same endpoint: enable at least these events (test + live):
# payment.captured (Reader /upgrade unlock), subscription.charged, subscription.cancelled,
# subscription.completed, subscription.pending, subscription.halted, payment.failed
# subscription.completed is required for marking access ended when all billing cycles finish.
#
# --- Pricing checkout (kalnehi.com /pricing) ---
# 1) Use the same mode everywhere: test keys + test plan ids, OR live keys + live plan ids.
# 2) In Razorpay → Plans, create one monthly INR subscription plan matching
#    src/lib/subscriptionTiers.ts: Pro ₹299 (29900 paise).
# 3) Prefer setting explicit plan id (avoids “duplicate plan” ambiguity):
# RAZORPAY_PLAN_ID_PRO=plan_xxxxxxxxxxxxxx
# 4) Vercel → Project → Settings → Environment Variables → Production: add RAZORPAY_KEY_* and
#    RAZORPAY_PLAN_ID_PRO (or rely on a single unique API match). Redeploy after changes.
# 5) Local check: `npm run verify:razorpay-pricing` (uses .env.local). For production-like Pro rules:
#    `NODE_ENV=production npm run verify:razorpay-pricing`

# Supabase service role key (never expose in client). Must be from the same project as NEXT_PUBLIC_SUPABASE_URL.
# Used for webhooks, PrepBrain AI (/api/prepbrain/*), and other server routes that read/update user_profiles with the service client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Apply pending migrations (linked project): from repo root, `npx supabase db push`.
# Requires the database password for direct Postgres access:
#   export SUPABASE_DB_PASSWORD='...'   # Supabase Dashboard → Project Settings → Database
# If the CLI errors on parsing .env.local, fix invalid escape sequences in that file, or run the
# SQL files under supabase/migrations/ manually in Supabase Dashboard → SQL Editor for each environment.
# Prefer `supabase db push` over Dashboard/MCP apply_migration so migration history stays in sync.

# Optional: Groq vision model for planner scan (default: llama-3.2-90b-vision-preview). Faster: llama-3.2-11b-vision-preview
# GROQ_PLANNER_VISION_MODEL=llama-3.2-90b-vision-preview

# Supabase Dashboard → Authentication → URL configuration:
# - Site URL: your deployed origin (e.g. https://your-app.vercel.app)
# - Redirect URLs: include https://your-origin/auth/callback (and http://localhost:3000/auth/callback for dev)
#   MULTI-VERTICAL: add BOTH brand callbacks so OAuth works on each domain:
#     https://www.kalnehi.com/auth/callback  AND  https://www.fizaki.in/auth/callback
#   (plus any *.vercel.app preview origins you use). Cookies are domain-scoped, so a session
#   on one brand domain does not bleed into the other.
# Enable Email provider + “Google” and set Google OAuth client ID/secret there.

# --- Firebase Cloud Messaging (web push) ---
# Firebase Console → Project settings → General: Web app config. Cloud Messaging: Web Push certificate (VAPID).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_FCM_VAPID_KEY=
# Optional: NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-...
# Server-only JSON (one line or escaped). Used by /api/fcm/test and /api/fcm/send.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Show "Send test notification" in Settings for owners/devs (at least one):
# NEXT_PUBLIC_FCM_DEV_TOOLS=1
# NEXT_PUBLIC_DEV_EMAIL=you@example.com
# FCM_ADMIN_EMAILS=owner@example.com
# FCM_ADMIN_USER_IDS=uuid-from-auth-users

# Vercel Cron → GET /api/cron/system-push?phase=morning|evening and GET /api/cron/custom-reminders (every 5 min). Authorization: Bearer …
# CRON_SECRET=

# --- Contact support (Resend) — /api/contact-support ---
# Create an API key at https://resend.com/api-keys. For local testing, you can use the default sender below.
RESEND_API_KEY=re_xxxxxxxx
# Must match a verified domain/sender in Resend. For testing without a domain: "App Name <onboarding@resend.dev>"
RESEND_FROM="Kalnehi Daily <onboarding@resend.dev>"
# Inbox that receives Contact support form submissions (reply-to is the user’s email).
CONTACT_SUPPORT_TO=support@yourdomain.com
# Production: add RESEND_API_KEY, RESEND_FROM, and CONTACT_SUPPORT_TO in your host’s env (e.g. Vercel → Project → Settings → Environment Variables).

# --- Android App Links / Digital Asset Links (Play Store) ---
# Required so /.well-known/assetlinks.json verifies App Link autoVerify in AndroidManifest.xml.
# Step 1: Upload the signed AAB to Play Console (any track — even internal testing).
# Step 2: Play Console → Setup → App integrity → App signing → copy the SHA-256 fingerprint.
# Step 3: Set both vars in Vercel Dashboard → Project → Settings → Environment Variables (Production).
# Step 4: Redeploy. Verify: curl https://www.kalnehi.com/.well-known/assetlinks.json
# TWA_PACKAGE_NAME=com.kalnehi.daily
# TWA_SHA256_FINGERPRINTS=AB:CD:EF:01:23:45:67:89:AB:CD:EF:01:23:45:67:89:AB:CD:EF:01:23:45:67:89:AB:CD:EF:01:23:45:67
