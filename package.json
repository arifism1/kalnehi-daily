{
  "name": "kalnehi-daily",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "react-doctor": "react-doctor . --yes",
    "react-doctor:verbose": "react-doctor . --verbose --yes",
    "react-doctor:diff": "react-doctor . --diff main --yes",
    "react-doctor:staged": "react-doctor . --staged --yes",
